{
  "uid": "lab-overview",
  "title": "Lab Overview",
  "description": "The labmon demo stack: five simulated sensors and one real serial acquisition path, both landing in the same database.",
  "tags": [
    "labmon",
    "demo"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "channel",
        "label": "Calibrated channel",
        "type": "custom",
        "query": "cryo-diode,pirani-1,laser-1,bias-monitor,beam-x,beam-y",
        "current": {
          "text": "cryo-diode",
          "value": "cryo-diode"
        },
        "includeAll": false,
        "multi": false
      },
      {
        "name": "room",
        "label": "Rooms",
        "type": "custom",
        "query": "room-1,room-2",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cold finger",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kelvin",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 20
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^value$/",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT time, value FROM temperature WHERE sensor_id = 'cryo-diode' AND $__timeFrom() <= time AND time <= $__timeTo() ORDER BY time"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Chamber pressure",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "description": "The Pirani channel's latest reading. Its response is logarithmic, so this value spans decades over a run and there is no sparkline here \u2014 the trend is in the Vacuum panel below, on a log axis.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:mbar",
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^value$/",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT time, value FROM pressure WHERE sensor_id = 'pirani-1' AND $__timeFrom() <= time AND time <= $__timeTo() ORDER BY time"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Laser power",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mwatt",
          "decimals": 1,
          "color": {
            "mode": "continuous-YlBl"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^value$/",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT time, value FROM power WHERE sensor_id = 'laser-1' AND $__timeFrom() <= time AND time <= $__timeTo() ORDER BY time"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bias rail",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "decimals": 2,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^value$/",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT time, value FROM voltage WHERE sensor_id = 'bias-monitor' AND $__timeFrom() <= time AND time <= $__timeTo() ORDER BY time"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Calibration layer \u2014 $channel",
      "description": "The board only ever sends raw ADC counts. The dashed line is the voltage those counts represent; the solid line is what the channel's entry in calibration.toml turns it into. Switch channels with the dropdown above \u2014 the conversion is linear, affine, piecewise or a formula depending on which one you pick, and none of it lives on the board. The left axis has no fixed unit precisely because it changes with the channel \u2014 the legend carries the unit the conversion produced.",
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "input_volts"
            },
            "properties": [
              {
                "id": "unit",
                "value": "volt"
              },
              {
                "id": "decimals",
                "value": 4
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    4
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "displayName",
                "value": "raw input (V)"
              },
              {
                "id": "custom.axisLabel",
                "value": "volts at the ADC"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "$channel (${__field.labels.unit})"
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT time, unit, input_volts, value FROM (\n     SELECT time, sensor_id, unit, input_volts, value FROM temperature\n     UNION ALL SELECT time, sensor_id, unit, input_volts, value FROM pressure\n     UNION ALL SELECT time, sensor_id, unit, input_volts, value FROM power\n     UNION ALL SELECT time, sensor_id, unit, input_volts, value FROM voltage\n     UNION ALL SELECT time, sensor_id, unit, input_volts, value FROM position\n   ) WHERE sensor_id = '$channel' AND $__timeFrom() <= time AND time <= $__timeTo() ORDER BY time"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT CASE unit\n       WHEN 'K' THEN 'kelvin'\n       WHEN 'mbar' THEN 'pressurembar'\n       WHEN 'mW' THEN 'mwatt'\n       WHEN 'V' THEN 'volt'\n       ELSE 'suffix:' || unit END AS unit_id\n   FROM (\n     SELECT time, sensor_id, unit, input_volts, value FROM temperature\n     UNION ALL SELECT time, sensor_id, unit, input_volts, value FROM pressure\n     UNION ALL SELECT time, sensor_id, unit, input_volts, value FROM power\n     UNION ALL SELECT time, sensor_id, unit, input_volts, value FROM voltage\n     UNION ALL SELECT time, sensor_id, unit, input_volts, value FROM position\n   ) WHERE sensor_id = '$channel' AND $__timeFrom() <= time AND time <= $__timeTo() ORDER BY time DESC LIMIT 1",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "B",
            "mappings": [
              {
                "fieldName": "unit_id",
                "handlerKey": "unit"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cryogenic zone",
      "description": "Three zones spanning two decades of temperature, so the axis is logarithmic. cryo-diode arrives through the serial/calibration path; the other two are simulated.",
      "gridPos": {
        "h": 10,
        "w": 10,
        "x": 14,
        "y": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "unit": "kelvin",
          "displayName": "${__field.labels.sensor_id}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT time, sensor_id, value FROM temperature WHERE sensor_id IN ('cryo-77k', 'cryo-4k', 'cryo-diode') AND $__timeFrom() <= time AND time <= $__timeTo() ORDER BY time"
        }
      ]
    },
    {
      "id": 7,
      "type": "briangann-gauge-panel",
      "title": "Laser detuning \u2014 1084 nm",
      "description": "A wavemeter watching the 1084 nm laser, shown as the offset from 276.5613 THz rather than as the absolute frequency: a few MHz of drift on a 276 THz carrier is one part in 10^8, and would never be visible on an absolute scale. Unlike the calibrated channels, a wavemeter reports a frequency directly, so there is no conversion to record.",
      "gridPos": {
        "h": 10,
        "w": 6,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "decimals": 2,
          "min": -10000000,
          "max": 10000000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -8000000
              },
              {
                "color": "yellow",
                "value": -5500000
              },
              {
                "color": "green",
                "value": -3000000
              },
              {
                "color": "blue",
                "value": -1000000
              },
              {
                "color": "green",
                "value": 1000000
              },
              {
                "color": "yellow",
                "value": 3000000
              },
              {
                "color": "orange",
                "value": 5500000
              },
              {
                "color": "red",
                "value": 8000000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "operatorName": "lastNotNull",
        "displayFormatted": "",
        "displayValue": null,
        "displayTitle": "",
        "showTitle": false,
        "showValue": true,
        "showTickLabels": true,
        "formatTickLabelsWithUnit": false,
        "minValue": -10000000,
        "maxValue": 10000000,
        "wrapValues": false,
        "tickSpacingMajor": 5000000,
        "tickSpacingMinor": 1000000,
        "showThresholdBandOnGauge": true,
        "showThresholdBandLowerRange": true,
        "showThresholdBandMiddleRange": true,
        "showThresholdBandUpperRange": true,
        "showThresholdStateOnValue": true,
        "showThresholdStateOnTitle": false,
        "showThresholdStateOnBackground": false,
        "animateNeedleValueTransition": true,
        "animateNeedleValueTransitionSpeed": 100,
        "allowNeedleCrossLimits": true,
        "needleCrossLimitDegrees": 10,
        "markerEndEnabled": false,
        "markerEndShape": "arrow",
        "markerStartEnabled": false,
        "markerStartShape": "circle",
        "outerEdgeColor": "#2c3235",
        "innerColor": "#111217",
        "pivotColor": "#ccccdc",
        "needleColor": "#f0f0f5",
        "unitsLabelColor": "#ccccdc",
