      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT time, value - 276561300000000.0 AS value FROM frequency WHERE sensor_id = 'wavemeter-1' AND $__timeFrom() <= time AND time <= $__timeTo() ORDER BY time"
        }
      ]
    },
    {
      "id": 8,
      "type": "xychart",
      "pluginVersion": "13.1.1",
      "title": "Beam position",
      "description": "Where the beam sits on a quadrant photodiode, from the two difference signals the detector puts out. Both arrive as ordinary ADC channels and are converted to microns by the calibration file, like everything else on the serial path. The origin is the aligned position and the axes are fixed and symmetric, so drift shows as the trace wandering off-centre; the large red point is where the beam is now.",
      "gridPos": {
        "h": 10,
        "w": 9,
        "x": 6,
        "y": 15
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:\u00b5m",
          "decimals": 1,
          "min": -50,
          "max": 50,
          "custom": {
            "show": "points+lines",
            "pointSize": {
              "fixed": 3
            },
            "pointShape": "circle",
            "pointStrokeWidth": 0,
            "lineWidth": 1,
            "fillOpacity": 25,
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "semi-dark-blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.pointSize",
                "value": {
                  "fixed": 14
                }
              },
              {
                "id": "custom.show",
                "value": "points"
              },
              {
                "id": "custom.pointStrokeWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "mapping": "manual",
        "series": [
          {
            "name": {
              "fixed": "trace"
            },
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            },
            "x": {
              "matcher": {
                "id": "byName",
                "options": "beam-x"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "beam-y"
              }
            }
          },
          {
            "name": {
              "fixed": "now"
            },
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 1
              }
            },
            "x": {
              "matcher": {
                "id": "byName",
                "options": "now-x"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "now-y"
              }
            }
          }
        ],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT x.t AS time, x.v AS \"beam-x\", y.v AS \"beam-y\" FROM\n     (SELECT date_trunc('second', time) AS t, avg(value) AS v FROM position\n        WHERE sensor_id = 'beam-x' AND $__timeFrom() <= time AND time <= $__timeTo() GROUP BY 1) x\n     JOIN\n     (SELECT date_trunc('second', time) AS t, avg(value) AS v FROM position\n        WHERE sensor_id = 'beam-y' AND $__timeFrom() <= time AND time <= $__timeTo() GROUP BY 1) y\n     ON x.t = y.t ORDER BY 1",
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT x.t AS time, x.v AS \"now-x\", y.v AS \"now-y\" FROM\n     (SELECT date_trunc('second', time) AS t, avg(value) AS v FROM position\n        WHERE sensor_id = 'beam-x' AND $__timeFrom() <= time AND time <= $__timeTo() GROUP BY 1) x\n     JOIN\n     (SELECT date_trunc('second', time) AS t, avg(value) AS v FROM position\n        WHERE sensor_id = 'beam-y' AND $__timeFrom() <= time AND time <= $__timeTo() GROUP BY 1) y\n     ON x.t = y.t ORDER BY 1 DESC LIMIT 1",
          "format": "table"
        }
      ]
    },
