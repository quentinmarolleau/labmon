        "tickMajorColor": "#ccccdc",
        "tickMinorColor": "#6e6e78",
        "gaugeRadius": 0,
        "pivotRadius": 0.08,
        "padding": 0.05,
        "edgeWidth": 0.05,
        "tickEdgeGap": 0.05,
        "tickLengthMaj": 0.15,
        "tickLengthMin": 0.05,
        "ticknessGaugeBasis": 200,
        "tickWidthMajor": 4,
        "tickWidthMinor": 1,
        "needleWidth": 4,
        "needleTickGap": 0.03,
        "needleLengthNeg": 0.2,
        "zeroTickAngle": 60,
        "maxTickAngle": 300,
        "zeroNeedleAngle": 40,
        "maxNeedleAngle": 320,
        "valueYOffset": 0,
        "valueFontSize": 34,
        "valueFont": "Inter",
        "titleYOffset": 0,
        "titleFontSize": 20,
        "titleFont": "Inter",
        "tickLabelFontSize": 22,
