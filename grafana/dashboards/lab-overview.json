      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb3"
          },
          "rawSql": "SELECT sensor_id, measurement, unit, value, input_volts,\n     COALESCE(calibration_id, '\u2014') AS calibration,\n     CASE WHEN calibration_id IS NULL THEN 'simulated' ELSE 'calibrated' END AS path,\n     date_part('epoch', now() - time) AS age_seconds\n   FROM (\n     SELECT 'temperature' AS measurement, sensor_id, calibration_id, unit,\n            CAST(round(value, 2) AS VARCHAR) AS value, input_volts, time,\n            ROW_NUMBER() OVER (PARTITION BY sensor_id ORDER BY time DESC) AS rn FROM temperature\n     UNION ALL SELECT 'pressure', sensor_id, calibration_id, unit,\n            CAST(round(value, 12) AS VARCHAR), input_volts, time,\n            ROW_NUMBER() OVER (PARTITION BY sensor_id ORDER BY time DESC) FROM pressure\n     UNION ALL SELECT 'power', sensor_id, calibration_id, unit,\n            CAST(round(value, 2) AS VARCHAR), input_volts, time,\n            ROW_NUMBER() OVER (PARTITION BY sensor_id ORDER BY time DESC) FROM power\n     UNION ALL SELECT 'voltage', sensor_id, calibration_id, unit,\n            CAST(round(value, 3) AS VARCHAR), input_volts, time,\n            ROW_NUMBER() OVER (PARTITION BY sensor_id ORDER BY time DESC) FROM voltage\n     UNION ALL SELECT 'position', sensor_id, calibration_id, unit,\n            CAST(round(value, 2) AS VARCHAR), input_volts, time,\n            ROW_NUMBER() OVER (PARTITION BY sensor_id ORDER BY time DESC) FROM position\n     UNION ALL SELECT 'frequency', sensor_id, CAST(NULL AS VARCHAR) AS calibration_id, 'THz' AS unit,\n            CAST(round(value / 1e12, 6) AS VARCHAR), CAST(NULL AS DOUBLE) AS input_volts, time,\n            ROW_NUMBER() OVER (PARTITION BY sensor_id ORDER BY time DESC) FROM frequency\n   ) WHERE rn = 1 ORDER BY path, measurement, sensor_id",
          "format": "table"
        }
      ]
