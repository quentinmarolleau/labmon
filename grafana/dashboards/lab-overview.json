    {
      "id": 10,
      "type": "timeseries",
      "title": "Laser power",
      "description": "The photodiode channel on its own, where the axis can carry a fixed unit \u2014 unlike the calibration panel above, whose unit changes with the channel.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb3"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          },
